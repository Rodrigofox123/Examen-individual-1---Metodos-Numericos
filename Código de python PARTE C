# ==========================================================

import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# ----------------------------------------------------------
# Datos experimentales
# ----------------------------------------------------------

f = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
], dtype=float)

Z = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
], dtype=float)

# ----------------------------------------------------------
# Construcción del spline cúbico natural
# ----------------------------------------------------------

spline = CubicSpline(f, Z, bc_type='natural')

# ----------------------------------------------------------
# Derivada primera y segunda del spline
# ----------------------------------------------------------

spline_d1 = spline.derivative(1)

spline_d2 = spline.derivative(2)

# ----------------------------------------------------------
# Malla fina de frecuencias
# ----------------------------------------------------------

f_fina = np.linspace(min(f), max(f), 2000)

# Evaluación de derivadas
dZ_df = spline_d1(f_fina)

d2Z_df2 = spline_d2(f_fina)

# ----------------------------------------------------------
# Búsqueda del mínimo:
# punto donde la derivada cambia de negativa a positiva
# ----------------------------------------------------------

indice_min = np.argmin(np.abs(dZ_df))

f_min = f_fina[indice_min]

Z_min = spline(f_min)

# ----------------------------------------------------------
# Segunda derivada en el mínimo
# ----------------------------------------------------------

segunda_derivada = spline_d2(f_min)

# ----------------------------------------------------------
# Resultados numéricos
# ----------------------------------------------------------

print("========== RESULTADOS ==========")

print(f"Frecuencia del mínimo = {f_min:.4f} Hz")

print(f"|Z| mínimo = {Z_min:.4f} ohm")

print(f"Segunda derivada en el mínimo = {segunda_derivada:.4f}")

# ----------------------------------------------------------
# Gráfica de la derivada primera
# ----------------------------------------------------------

plt.figure(figsize=(10,6))

plt.plot(f_fina, dZ_df, linewidth=2,
         label='d|Z|/df')

# Línea horizontal y = 0
plt.axhline(0, color='black', linestyle='--')

# Punto crítico
plt.plot(f_min, spline_d1(f_min), 'ro',
         markersize=8,
         label='Cambio de signo')

plt.xlabel('Frecuencia (Hz)')
plt.ylabel('d|Z|/df')

plt.title('Derivada primera de la impedancia')

plt.grid(True)
plt.legend()

plt.show()
