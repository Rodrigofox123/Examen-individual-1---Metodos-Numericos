import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# ============================================
# DATOS
# ============================================

f = np.array([
    10.0,12.5,15.0,17.5,20.0,22.5,25.0,27.5,30.0,32.5,
    35.0,37.5,40.0,42.5,45.0,47.5,50.0,52.5,55.0,57.5,
    60.0,62.5,65.0,67.5,70.0,72.5,75.0,77.5,80.0,82.5,
    85.0,87.5,90.0,92.5,95.0,97.5,100.0,102.5,105.0,107.5
])

V = np.array([
    0.842,0.911,0.986,1.062,1.143,1.227,1.314,1.401,1.482,1.551,
    1.216,1.048,0.866,0.689,0.521,0.364,0.223,0.103,0.012,-0.041,
    -0.057,-0.034,0.018,0.096,0.197,0.318,0.452,0.579,0.700,0.809,
    0.611,0.688,0.756,0.811,0.856,0.894,0.926,0.954,0.980,1.004
])

# ============================================
# 3.1 DETECCIÓN DEL CAMBIO DE SIGNO
# ============================================

for i in range(len(V)-1):

    # Si hay cambio de signo existe raíz
    if V[i] * V[i+1] < 0:

        a = f[i]
        b = f[i+1]

        print(f"Cambio de signo entre {a} kHz y {b} kHz")

# ============================================
# MÉTODO DE BISECCIÓN
# ============================================

def biseccion(x, y, a, b, tol=1e-6):

    # Interpolación lineal para evaluar V(f)
    def interp(valor):
        return np.interp(valor, x, y)

    fa = interp(a)
    fb = interp(b)

    while abs(b-a) > tol:

        c = (a+b)/2
        fc = interp(c)

        if fa*fc < 0:
            b = c
            fb = fc
        else:
            a = c
            fa = fc

    return (a+b)/2

# Intervalo encontrado
raiz_biseccion = biseccion(f, V, 55.0, 57.5)

# ============================================
# SPLINE CÚBICO
# ============================================

spline_V = CubicSpline(f, V, bc_type='natural')

# Mallado fino
f_suave = np.linspace(min(f), max(f), 5000)

# Valores spline
V_suave = spline_V(f_suave)

# Aproximación de raíz spline
indice = np.argmin(np.abs(V_suave))
raiz_spline = f_suave[indice]

# ============================================
# RESULTADOS
# ============================================

print("\n=========== RESULTADOS ===========")

print(f"Raíz por bisección = {raiz_biseccion:.6f} kHz")

print(f"Raíz por spline    = {raiz_spline:.6f} kHz")

# ============================================
# GRÁFICA
# ============================================

plt.figure(figsize=(11,5))

# Datos experimentales
plt.plot(f, V, 'o', label='Datos experimentales')

# Curva spline
plt.plot(f_suave, V_suave, label='Spline cúbico')

# Línea y = 0
plt.axhline(0, linestyle='--')

# Raíz por bisección
plt.plot(raiz_biseccion, 0, 'rs',
         markersize=8,
         label='Raíz por bisección')

# Raíz spline
plt.plot(raiz_spline, 0, 'g^',
         markersize=8,
         label='Raíz spline')

# Configuración
plt.title('Localización de raíces de V(f)')
plt.xlabel('Frecuencia (kHz)')
plt.ylabel('Voltaje V(f)')
plt.grid(True)
plt.legend()

plt.show()
