import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# ============================================
# DATOS DEL ENSAYO
# ============================================

f = np.array([
    10.0,12.5,15.0,17.5,20.0,22.5,25.0,27.5,30.0,32.5,
    35.0,37.5,40.0,42.5,45.0,47.5,50.0,52.5,55.0,57.5,
    60.0,62.5,65.0,67.5,70.0,72.5,75.0,77.5,80.0,82.5,
    85.0,87.5,90.0,92.5,95.0,97.5,100.0,102.5,105.0,107.5
])

V = np.array([
    0.842,0.911,0.986,1.062,1.143,1.227,1.314,1.401,1.482,1.551,
    1.216,1.048,0.866,0.689,0.521,0.364,0.223,0.103,0.012,-0.041,
    -0.057,-0.034,0.018,0.096,0.197,0.318,0.452,0.579,0.700,0.809,
    0.611,0.688,0.756,0.811,0.856,0.894,0.926,0.954,0.980,1.004
])

Z = np.array([
    182.4,178.9,175.1,171.0,166.8,162.7,158.9,155.4,152.0,149.0,
    146.1,145.2,145.8,147.3,149.9,153.5,158.0,163.2,168.9,174.8,
    180.5,186.2,191.5,196.2,200.1,203.1,205.2,206.3,206.1,204.7,
    198.0,194.4,190.9,187.8,185.1,183.0,181.6,180.8,180.6,180.9
])

# ============================================
# FUNCIÓN DE LAGRANGE DE SEGUNDO GRADO
# ============================================

def lagrange2(x, xp, yp):

    # Polinomio interpolante de Lagrange grado 2
    L0 = ((x - xp[1]) * (x - xp[2])) / ((xp[0] - xp[1]) * (xp[0] - xp[2]))
    L1 = ((x - xp[0]) * (x - xp[2])) / ((xp[1] - xp[0]) * (xp[1] - xp[2]))
    L2 = ((x - xp[0]) * (x - xp[1])) / ((xp[2] - xp[0]) * (xp[2] - xp[1]))

    return yp[0]*L0 + yp[1]*L1 + yp[2]*L2

# ============================================
# INTERPOLACIÓN LAGRANGE
# ============================================

# Para 41 kHz
xp1 = np.array([37.5, 40.0, 42.5])

V_41 = lagrange2(41.0, xp1, np.array([1.048, 0.866, 0.689]))
Z_41 = lagrange2(41.0, xp1, np.array([145.2, 145.8, 147.3]))

# Para 73 kHz
xp2 = np.array([70.0, 72.5, 75.0])

V_73 = lagrange2(73.0, xp2, np.array([0.197, 0.318, 0.452]))
Z_73 = lagrange2(73.0, xp2, np.array([200.1, 203.1, 205.2]))

# ============================================
# SPLINE CÚBICO NATURAL
# ============================================

spline_V = CubicSpline(f, V, bc_type='natural')
spline_Z = CubicSpline(f, Z, bc_type='natural')

# Evaluación de spline
V_41_spline = spline_V(41.0)
Z_41_spline = spline_Z(41.0)

V_73_spline = spline_V(73.0)
Z_73_spline = spline_Z(73.0)

# ============================================
# RESULTADOS NUMÉRICOS
# ============================================

print("=========== LAGRANGE GRADO 2 ===========")
print(f"V(41 kHz)   = {V_41:.6f} V")
print(f"|Z|(41 kHz) = {Z_41:.6f} ohm")

print(f"V(73 kHz)   = {V_73:.6f} V")
print(f"|Z|(73 kHz) = {Z_73:.6f} ohm")

print("\n=========== SPLINE CÚBICO ===========")
print(f"V(41 kHz)   = {V_41_spline:.6f} V")
print(f"|Z|(41 kHz) = {Z_41_spline:.6f} ohm")

print(f"V(73 kHz)   = {V_73_spline:.6f} V")
print(f"|Z|(73 kHz) = {Z_73_spline:.6f} ohm")

# ============================================
# GRAFICAR SPLINES Y PUNTOS INTERPOLADOS
# ============================================

# Mallado fino para curvas suaves
f_suave = np.linspace(min(f), max(f), 1000)

# Valores spline
V_suave = spline_V(f_suave)
Z_suave = spline_Z(f_suave)

# ============================================
# GRÁFICA DE V(f)
# ============================================

plt.figure(figsize=(10,5))

# Datos originales
plt.plot(f, V, 'o', label='Datos experimentales')

# Curva spline
plt.plot(f_suave, V_suave, label='Spline cúbico natural')

# Puntos interpolados
plt.plot(41, V_41, 'rs', markersize=8, label='Lagrange V(41)')
plt.plot(73, V_73, 'gs', markersize=8, label='Lagrange V(73)')

plt.plot(41, V_41_spline, 'r^', markersize=8, label='Spline V(41)')
plt.plot(73, V_73_spline, 'g^', markersize=8, label='Spline V(73)')

plt.title('Interpolación de V(f)')
plt.xlabel('Frecuencia (kHz)')
plt.ylabel('Voltaje V(f)')
plt.grid(True)
plt.legend()

# ============================================
# GRÁFICA DE |Z|(f)
# ============================================

plt.figure(figsize=(10,5))

# Datos originales
plt.plot(f, Z, 'o', label='Datos experimentales')

# Curva spline
plt.plot(f_suave, Z_suave, label='Spline cúbico natural')

# Puntos interpolados
plt.plot(41, Z_41, 'rs', markersize=8, label='Lagrange |Z|(41)')
plt.plot(73, Z_73, 'gs', markersize=8, label='Lagrange |Z|(73)')

plt.plot(41, Z_41_spline, 'r^', markersize=8, label='Spline |Z|(41)')
plt.plot(73, Z_73_spline, 'g^', markersize=8, label='Spline |Z|(73)')

plt.title('Interpolación de |Z|(f)')
plt.xlabel('Frecuencia (kHz)')
plt.ylabel('|Z|(ohm)')
plt.grid(True)
plt.legend()

plt.show()
