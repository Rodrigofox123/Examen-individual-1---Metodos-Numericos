import numpy as np
import matplotlib.pyplot as plt

# --------------------------------------------
# Datos experimentales
# --------------------------------------------

f = np.array([
    100,120,145,170,200,235,270,310,355,405,
    460,520,585,655,730,810,895,985,1080,1180,
    1290,1410,1540,1680,1830,1990,2160,2340,2530,2730
])

Z = np.array([
    152.3,149.1,146.8,144.9,142.0,139.5,137.9,136.1,134.8,133.6,
    132.7,131.9,131.4,131.1,130.9,131.0,131.3,131.9,132.7,133.8,
    135.2,136.9,138.9,141.1,143.5,146.1,149.0,152.2,155.6,159.2
])

# --------------------------------------------
# Identificación del mínimo
# --------------------------------------------

indice_min = np.argmin(Z)

f_min = f[indice_min]
Z_min = Z[indice_min]

# --------------------------------------------
# Resultados numéricos
# --------------------------------------------

print("========== RESULTADOS ==========")
print(f"Frecuencia del mínimo: {f_min:.4f} Hz")
print(f"Impedancia mínima: {Z_min:.4f} ohm")

# --------------------------------------------
# Gráfico
# --------------------------------------------

plt.figure(figsize=(9,5))

plt.plot(f, Z, 'o-', linewidth=2, markersize=6,
         label='Datos experimentales')

plt.plot(f_min, Z_min, 'ro', markersize=10,
         label='Mínimo local')

plt.xlabel('Frecuencia f (Hz)')
plt.ylabel('|Z| (ohm)')

plt.title('Impedancia |Z| en función de la frecuencia')

plt.grid(True)
plt.legend()

plt.show()
